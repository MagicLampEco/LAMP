{
  "name": "@magiclamp/tiger-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Early TIGER Delegator SDK — entitlement tích lũy stake (snapshot trước cutoff) + drip kiểu B trên claim_account đã audit",
  "main":  "dist/offchain/src/index.js",
  "types": "dist/offchain/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/offchain/src/index.d.ts",
      "import": "./dist/offchain/src/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build":      "tsc",
    "test":       "vitest run",
    "test:watch": "vitest",
    "typecheck":  "tsc --noEmit",
    "snapshot":   "tsx ../scripts/build_tiger_snapshot.ts"
  },
  "devDependencies": {
    "tsx":        "^4.7.0",
    "typescript": "^5.4.0",
    "vitest":     "^1.6.0"
  }
}
