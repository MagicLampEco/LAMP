# Treasury/scripts/.env — sao chép thành .env rồi điền. KHÔNG commit .env thật.
#
# THIẾU credential → script chạy DRY mode (apply-params + in plan/hash/address/datum,
# KHÔNG build/submit tx). Đủ credential → buildSeedTx dry-run (.complete(), KHÔNG submit).

# ── Bắt buộc để build tx thật (LIVE) ──────────────────────────────
# Blockfrost project key (Preview). Lấy ở https://blockfrost.io.
BLOCKFROST_KEY=

# Ví deploy testnet — MỘT trong hai (KHÔNG dùng ví mainnet):
PRIVATE_KEY=
# hoặc seed phrase (15/24 từ, cách nhau khoảng trắng):
WALLET_SEED=

# ── Network ───────────────────────────────────────────────────────
NETWORK=Preview

# ── Tham số instance custody (INSTANCE_ID/RESERVED_MIN_ADA có default dev; CUT_BPS + BUCKETS BẮT BUỘC) ─
# instance_id (ASCII, sẽ encode hex; = seed NFT name). Mặc định: treasury-custody-v1.
INSTANCE_ID=treasury-custody-v1
# cut_bps ∈ [0,10000] — BẮT BUỘC (SEED-CUT-001), nướng vĩnh viễn vào datum genesis.
# Instance custody chung dùng 10000.
CUT_BPS=10000
# id category ĐÓNG, tăng ngặt, không id dành riêng — BẮT BUỘC (SEED-BKT-001), không đổi được sau seed.
# Collect chỉ nhận item mang id có trong danh sách này (C-COL-CAT). Giá trị dưới đây là MẪU.
BUCKETS=0,1,2,3
# lovelace giữ min-UTxO seed (≥ 0).
RESERVED_MIN_ADA=2000000

# proposal_policy: PolicyId beacon Governance (gác Release). Trống → placeholder dev.
# Production: điền policy id của Governance proposal NFT.
PROPOSAL_POLICY_ID=
# governance_ref: script hash Governance gắn treasury này (28-byte hex). Trống → placeholder.
GOVERNANCE_REF=

# genesis_ref (chỉ DRY mode KHÔNG có ví): "txhash#index" của UTxO sẽ tiêu khi seed.
# LIVE mode tự chọn UTxO đầu của ví → bỏ trống.
GENESIS_REF=
