{
  "compilerOptions": {
    "target":           "ES2022",
    "module":           "NodeNext",
    "moduleResolution": "NodeNext",
    "lib":              ["ES2022"],
    "strict":           true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess":   true,
    "skipLibCheck":     true,
    "noEmit":           true,
    "baseUrl":          ".",
    "paths": {
      "@magiclamp/treasury-sdk": ["../../Treasury/offchain/src/index.ts"]
    }
  },
  "include": ["*.ts", "../offchain/src/**/*"],
  "exclude": ["node_modules"]
}
