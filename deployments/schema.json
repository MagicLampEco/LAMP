{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MagicLampEco/LAMP/blob/main/deployments/schema.json",
  "title": "LAMP deployments manifest",
  "description": "Generated by Genesis/scripts/emit_deployments.ts from Genesis/offchain/src/deploymentsManifest.ts. Cross-record rules (supersededBy chain, one ACTIVE per role+cluster, address <-> scriptHash, lamp-token == policy registry) are enforced by validateDeployments(), not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "network", "networkMagic", "clock", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "network": { "enum": ["mainnet", "preprod", "preview"] },
    "networkMagic": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["msPerEpoch", "windowOriginMs"],
      "properties": {
        "msPerEpoch": { "$ref": "#/$defs/positiveDecimal" },
        "windowOriginMs": { "oneOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] }
      }
    },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "positiveDecimal": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "hex56": { "type": "string", "pattern": "^[0-9a-f]{56}$" },
    "recordId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?$" },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "role", "cluster", "status", "supersededBy", "policyId", "assetName",
        "scriptHash", "address", "params", "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/recordId" },
        "role": {
          "enum": [
            "lamp-token",
            "supply-marker",
            "registry-marker",
            "meter-marker",
            "treasury-marker",
            "beacon-marker",
            "reserve-custody-nft",
            "governance-pointer",
            "supply-state",
            "registry",
            "distribution-treasury",
            "claim-account",
            "claim-account-nft",
            "beacon",
            "faucet",
            "lock-vault",
            "treasury-custody"
          ]
        },
        "cluster": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "status": { "enum": ["ACTIVE", "SUPERSEDED", "PENDING"] },
        "supersededBy": { "oneOf": [{ "$ref": "#/$defs/recordId" }, { "type": "null" }] },
        "policyId": { "oneOf": [{ "$ref": "#/$defs/hex56" }, { "type": "null" }] },
        "assetName": { "oneOf": [{ "type": "string", "pattern": "^([0-9a-f]{2}){0,32}$" }, { "type": "null" }] },
        "scriptHash": { "oneOf": [{ "$ref": "#/$defs/hex56" }, { "type": "null" }] },
        "address": { "oneOf": [{ "type": "string", "pattern": "^addr(_test)?1[02-9ac-hj-np-z]+$" }, { "type": "null" }] },
        "params": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
          "additionalProperties": { "type": "string" }
        },
        "mintClosed": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(tx:[0-9a-f]{64}|file:[A-Za-z0-9._/-]+)$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "SUPERSEDED" } } },
          "then": { "properties": { "supersededBy": { "$ref": "#/$defs/recordId" } } },
          "else": { "properties": { "supersededBy": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "const": "PENDING" } } },
          "then": {
            "properties": {
              "policyId": { "type": "null" },
              "scriptHash": { "type": "null" },
              "address": { "type": "null" }
            }
          },
          "else": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": { "required": ["mintClosed"] },
          "then": { "properties": { "role": { "const": "lamp-token" } } }
        }
      ]
    }
  }
}
