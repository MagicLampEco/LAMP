# PlatformKit/scripts/.env — sao chép thành .env rồi điền. KHÔNG commit .env thật.
#
# THIẾU credential → DRY mode (apply-params + plan + datum/hash/address, KHÔNG build tx).
# ĐỦ credential → 03_onboard build 2 tx dry-run (.complete(), KHÔNG submit).

# ── Bắt buộc để build tx thật (LIVE) ──────────────────────────────
BLOCKFROST_KEY=
PRIVATE_KEY=
# hoặc:
WALLET_SEED=

NETWORK=Preview

# ── Registry (02_deploy_registry + 03_onboard) ────────────────────
# registry_authority: payment key-hash (28-byte hex) committee→DAO ký Register/Update.
# Trống → placeholder dev (KHÔNG ký được — chỉ apply-params/in hash).
REGISTRY_AUTHORITY=

# ── Custody (03_onboard apply Treasury custody) ───────────────────
# proposal_policy: PolicyId beacon Governance gác Release. Trống → placeholder.
PROPOSAL_POLICY_ID=
# genesis_ref (chỉ DRY KHÔNG có ví): "txhash#index" UTxO tiêu khi seed. LIVE tự chọn → bỏ trống.
GENESIS_REF=
# created_epoch (epoch đăng ký). Mặc định 0 (dev).
CREATED_EPOCH=0

# ── Policy thật (điền sau khi deploy Distribution/MAGIC) ──────────
# LAMP/MAGIC policy id — vào accepted_assets của platform config. Trống → placeholder dev.
LAMP_POLICY_ID=
MAGIC_POLICY_ID=
