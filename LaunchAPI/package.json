{
  "name": "@magiclamp/launch-api",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "MagicLamp Launch API — content push đến affiso.net, magiclamp.network, SuperApp",
  "scripts": {
    "start": "npx tsx src/server.ts",
    "dev": "npx tsx --watch src/server.ts",
    "build": "tsc",
    "start:compiled": "node dist/server.js",
    "test": "npm run check && npm run check:patch",
    "check": "npx tsx tests/publicCampaign.check.ts",
    "check:patch": "npx tsx tests/patchParams.check.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
